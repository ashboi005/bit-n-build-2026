# Copy to .env and fill in. In Coolify, paste these as environment variables.

NODE_ENV=development

# --- Auth ---
# Any random string, 32+ chars. Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Public URL of THIS server. Coolify: https://thwip-api.ashwathsoni.dev
BETTER_AUTH_URL=https://thwip-api.ashwathsoni.dev
# Public URL of the WEB app. Coolify: https://thwip.ashwathsoni.dev
CORS_ORIGIN=https://thwip.ashwathsoni.dev

# --- Chrome private alpha OAuth ---
# The production API URL, also used as the OAuth resource/audience.
EXTENSION_API_AUDIENCE=https://thwip-api.ashwathsoni.dev
# Generated once when the public Chrome OAuth client is provisioned.
EXTENSION_CHROME_CLIENT_ID=
# Stable unpacked or Chrome Web Store extension ID (exactly 32 characters).
EXTENSION_CHROME_ID=

# --- Database ---
# Postgres connection string.
DATABASE_URL=postgres://user:pass@host:5432/postgres

# --- Merge Gateway (LLM) ---
# One key reaches Anthropic, Google, OpenAI etc. https://www.merge.dev/gateway
MERGE_API_KEY=
# ⚠️ VERIFY THIS against your Merge dashboard. Their docs show two different
# hosts and we currently get 405 from the one below, which means wrong host/path.
# Try the other if calls fail: https://api-gateway.merge.dev/v1
MERGE_BASE_URL=https://api-gateway.merge.dev/v1
# ⚠️ VERIFY these model ids too. Run the listModels() helper once and pin
# whatever your key actually returns — an unknown id fails at call time.
MERGE_MODEL_SMART=deepseek/deepseek-v4.1-flash
MERGE_MODEL_FAST=zai/glm-4.7-flash
MERGE_MODEL_EMBED=google/gemini-embedding-001

# --- Vector search (OPTIONAL — see docs/running.md) ---
# Leave BLANK unless you actually self-host Qdrant. Blank = in-memory vectors,
# which is the recommended setup for a 20-stock dataset.
QDRANT_URL=
QDRANT_API_KEY=

# --- Runtime ---
# Coolify injects this automatically. Only set it locally if 3000 is taken.
PORT=3000
