# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @dynamic @type=url
BETTER_AUTH_URL=

# @public @dynamic @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# --- Merge Gateway (LLM) ---

# @type=string(minLength=1)
MERGE_API_KEY=

# @public @type=url
MERGE_BASE_URL=https://api-gateway.merge.dev/v1

# @public @type=string
MERGE_MODEL_SMART=anthropic/claude-sonnet-5

# @public @type=string
MERGE_MODEL_FAST=google/gemini-3.5-flash

# @public @type=string
MERGE_MODEL_EMBED=google/gemini-embedding-001

# --- Vector search (OPTIONAL) ---
# Leave both blank to use in-memory vector search, which is the default and is
# fine for a 20-stock dataset. Set these only if you self-host Qdrant.

# @required=false @public @type=string
QDRANT_URL=

# @required=false @type=string
QDRANT_API_KEY=
