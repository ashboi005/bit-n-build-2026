# Deployed API origin. The host permission is generated from this exact origin.
WXT_API_ORIGIN=https://api-thwip.ashwathsoni.dev
# The registered public OAuth client ID (not a secret).
WXT_OAUTH_CLIENT_ID=
# Stable 32-character Chrome extension ID.
WXT_EXTENSION_ID=
# Optional base64 public key used to keep the unpacked extension ID stable.
WXT_EXTENSION_KEY=
